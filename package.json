{
  "name": "react-state-hooks",
  "version": "1.0.6",
  "description": "Collection of hooks to manage state.",
  "keywords": [
    "hooks",
    "react",
    "react-native",
    "state"
  ],
  "license": "MIT",
  "author": {
    "name": "Caio Teixeira",
    "email": "caioedut@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caioedut/react-state-hooks.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "tsx scripts/test.ts",
    "test:coverage": "bun scripts/test.ts --coverage",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "check:package": "attw --pack .",
    "build": "tsx scripts/build.ts",
    "publish:stable": "tsx scripts/publish.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "pmex": "^3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
